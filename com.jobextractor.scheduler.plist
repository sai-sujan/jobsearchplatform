<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobextractor.scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/saisujan/Desktop/internships_apply/clawdbot_automation/job-applications/run_scheduled.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/saisujan/Desktop/internships_apply/clawdbot_automation/job-applications</string>

    <!-- Run every 3 hours (10800 seconds) -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <key>StandardOutPath</key>
    <string>/Users/saisujan/Desktop/internships_apply/clawdbot_automation/job-applications/logs/launchd_output.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/saisujan/Desktop/internships_apply/clawdbot_automation/job-applications/logs/launchd_error.log</string>

    <!-- Run on load (when user logs in) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive - restart if crashes -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Throttle restarts -->
    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
