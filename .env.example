# Browser Configuration
BROWSER=chrome

# Chrome executable path on macOS
# Default Chrome path on macOS:
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Chrome profile path with LinkedIn logged in
# Find your profile path: chrome://version/ -> Profile Path
# Example: /Users/yourusername/Library/Application Support/Google/Chrome/Default
CHROME_PROFILE_PATH=/Users/yourusername/Library/Application Support/Google/Chrome/Default

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# LinkedIn Search Configuration (optional overrides)
# Job search keywords - comma separated
SEARCH_KEYWORDS=machine learning engineer,AI engineer,ML engineer,data scientist

# Location filter (optional)
LOCATION=United States

# Number of jobs to collect before filtering
MAX_JOBS_TO_COLLECT=40

# Number of top jobs to keep after evaluation
TOP_JOBS_TO_KEEP=5

# Safety delay between LinkedIn actions (seconds)
ACTION_DELAY=2

# OpenAI model to use for evaluation
OPENAI_MODEL=gpt-4-turbo-preview
