# =============================================================================
# Job Search Platform - Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# === Browser Settings ===
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
USE_EXISTING_CHROME=True
CHROME_USER_DATA_DIR=/Users/yourusername/Library/Application Support/Google/Chrome
CHROME_PROFILE_DIR=Default
CHROME_PROFILE_PATH=

# === Search Queries (customize per role) ===
KEYWORDS_AI_ENGINEER=("AI Engineer" OR "Artificial Intelligence Engineer") NOT (Senior OR Sr. OR Principal OR Staff OR Lead OR Manager)
KEYWORDS_ML_ENGINEER=("Machine Learning Engineer" OR "ML Engineer") NOT (Senior OR Sr. OR Principal OR Staff OR Lead OR Manager)
KEYWORDS_DATA_SCIENTIST="Data Scientist" AND ("Machine Learning" OR "Deep Learning" OR "AI" OR "Generative AI") NOT (Senior OR Sr. OR Principal OR Staff OR Lead OR Manager)
JOBS_PER_QUERY=20

# === Search Parameters ===
SEARCH_LOCATIONS=["United States"]
EXPERIENCE_LEVELS=["Internship", "Entry level"]
DATE_POSTED=24h

# === Scheduling ===
SCHEDULE_INTERVAL_HOURS=3
SCHEDULE_START_HOUR=9
SCHEDULE_END_HOUR=24

# === Delays (seconds) ===
ACTION_DELAY=2
MIN_DELAY=3
MAX_DELAY=7

# === Scoring ===
KEYWORD_MATCH_WEIGHT=0.4
YOE_WEIGHT=0.3
EDUCATION_WEIGHT=0.3
PREMIUM_BOOST=5
TOP_JOBS_TO_KEEP=10
MAX_JOBS_TO_COLLECT=40

# === LLM Configuration ===
# Options: "gemini", "local-airllm", "simple"
EVALUATOR_TYPE=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AIRLLM_MODEL=google/gemma-2-2b-it
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
GROQ_API_KEYS=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LIGHT_MODEL=llama-3.1-8b-instant
AI_MATCH_ENABLED=True
AI_MATCH_MODEL=
AI_MATCH_MAX_RESUME_CHARS=1400
AI_MATCH_MAX_JOB_CHARS=1800
AI_MATCH_MAX_SKILLS=12
AI_MATCH_MAX_TOKENS=350
AI_TAILOR_MAX_JOB_CHARS=2200
AI_TAILOR_MAX_TOKENS=700

# === API Server ===
API_PORT=5001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174
JWT_SECRET=change-me-in-production
SESSION_COOKIE_NAME=jobapp_session
CSRF_COOKIE_NAME=jobapp_csrf
SESSION_EXPIRES_HOURS=24
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
INTERNAL_API_TOKEN=change-me-internal-service-token
LEGACY_DELIVERY_FALLBACK_ENABLED=True

# === Resume ===
RESUME_PATH=/path/to/your/resume/master_resume.txt
